      "contract_source": "/inputs/specification",
      "failure_mode": "DETERMINISTIC_PREPARATION_NOT_APPLICABLE",
      "input_selectors": [
        "/inputs/historical_input",
        "/inputs/specification/input_literal_replacements"
      ],
      "oracle": "independent split/join replay and preservation checks",
      "output_selector": "/artifact/input_text",
      "preconditions": "each old literal occurs exactly once",
      "rule_id": "R-02",
      "rule_type": "LITERAL_SUBSTITUTION",
      "rule_version": "1",
      "transformation": "ordered exact replacement"
    },
    {
      "authority_source": "ExecutionContext schema",
      "contract_source": "ExecutionResult schema",
      "failure_mode": "DETERMINISTIC_PREPARATION_NOT_APPLICABLE",
      "input_selectors": [
        "/task_id",
        "/execution_id",
        "/context_id",
        "/input_revision"
      ],
      "oracle": "strict identity comparison",
      "output_selector": "/identity_fields",
      "preconditions": "valid bound context identity",
      "rule_id": "R-03",
      "rule_type": "EXACT_COPY",
      "rule_version": "1",
      "transformation": "copy identity and digest context"
    },
    {
      "authority_source": "bounded computation authority",
      "contract_source": "ExecutionResult schema",
      "failure_mode": "DETERMINISTIC_PREPARATION_NOT_APPLICABLE",
      "input_selectors": [
        "/role",
        "/inputs/operation",
        "/inputs/specification"
      ],
      "oracle": "strict allowlist and no effects/destination",
      "output_selector": "/status_fields",
      "preconditions": "bounded deterministic preparation only",
      "rule_id": "R-04",
      "rule_type": "VERSIONED_TEMPLATE",
      "rule_version": "1",
      "transformation": "emit fixed non-routing result facts"
    }
  ]
